# =====================================================
# 이 파일을 복사해 .env 를 만들고 실제 값을 입력하세요
# cp .env.example .env
# (.env 는 .gitignore 에 의해 커밋되지 않습니다)
# =====================================================

# Anthropic API Key (claude.ai → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Google / YouTube API Key (console.cloud.google.com → API & Services)
YOUTUBE_API_KEY=AIzaSy...

# Flask 세션 암호화 키 (임의 문자열, 예: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=
